---
import Base from '../layouts/Base.astro';
---

<Base title="lab" description="A creative coding lab by a frontend developer based in Denmark.">
  <section class="hero">
    <canvas id="field" aria-hidden="true"></canvas>

    <div class="hero-content">
      <p class="eyebrow mono dim">creative lab</p>
      <h1>making things<br /><span class="accent">move &amp; think</span></h1>
      <p class="hero-sub">
        Experiments in WebGL, generative systems,<br />
        and whatever felt worth building this week.
      </p>
      <a href="/lab" class="cta">browse experiments →</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: var(--space-xl) var(--space-lg);
    max-width: var(--max-w);
    margin-inline: auto;
    width: 100%;
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  h1 {
    margin-bottom: var(--space-lg);
  }

  .accent {
    color: var(--accent-hi);
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--text-dim);
    max-width: 38ch;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  .cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-hi);
    border: 1px solid rgba(123, 97, 255, 0.4);
    padding: 0.6em 1.2em;
    border-radius: var(--radius);
    transition: background 0.15s, border-color 0.15s;
  }

  .cta:hover {
    background: var(--glow);
    border-color: var(--accent);
    text-decoration: none;
  }
</style>

<script>
  // Particle field — a drifting constellation of dots connected by proximity
  const canvas = document.getElementById('field') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  let W = 0, H = 0;
  let particles: Particle[] = [];

  const COUNT = 80;
  const MAX_DIST = 140;
  const SPEED = 0.3;

  class Particle {
    x: number; y: number;
    vx: number; vy: number;

    constructor() {
      this.x = Math.random() * W;
      this.y = Math.random() * H;
      const angle = Math.random() * Math.PI * 2;
      this.vx = Math.cos(angle) * SPEED;
      this.vy = Math.sin(angle) * SPEED;
    }

    update() {
      this.x += this.vx;
      this.y += this.vy;
      if (this.x < 0 || this.x > W) this.vx *= -1;
      if (this.y < 0 || this.y > H) this.vy *= -1;
    }
  }

  function resize() {
    W = canvas.width = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
    particles = Array.from({ length: COUNT }, () => new Particle());
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    for (let i = 0; i < particles.length; i++) {
      const a = particles[i];
      a.update();

      // dot
      ctx.beginPath();
      ctx.arc(a.x, a.y, 1.5, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(123, 97, 255, 0.5)';
      ctx.fill();

      // edges
      for (let j = i + 1; j < particles.length; j++) {
        const b = particles[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < MAX_DIST) {
          const alpha = (1 - dist / MAX_DIST) * 0.25;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.strokeStyle = `rgba(123, 97, 255, ${alpha})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }

    requestAnimationFrame(draw);
  }

  const ro = new ResizeObserver(resize);
  ro.observe(canvas.parentElement!);
  resize();
  draw();
</script>
